# Meta Model API key (https://dev.meta.ai). Leave empty to run with mock models.
MODEL_API_KEY=
# Force mock models even with a key (1 = on).
META_MOCK=
PORT=4000
DB_PATH=mileto.db
# Optional overrides
# META_API_BASE_URL=https://api.meta.ai/v1
# META_SPARK_MODEL=muse-spark-1.1
# Muse Spark always reasons. "minimal" keeps replies fast; the token limit must leave room for reasoning.
# META_REASONING_EFFORT=minimal
# META_MAX_COMPLETION_TOKENS=3000
# META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# META_SAM_MODEL=sam-3.1
# META_IMAGE_MODEL=muse-image-1.0
